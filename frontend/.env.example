# URL do Apps Script, a que termina em /exec. No Vercel: Settings → Environment Variables.
# Atualizar o backend é SEMPRE "Gerenciar implantações → ✏️ → Nova versão".
# "Nova implantação" cria outra URL e o PWA inteiro para.
VITE_API_URL=https://script.google.com/macros/s/SEU_ID/exec

# Endereço do app HTML antigo (o mesmo /exec), mostrado na tela de erro como plano B.
# Se ficar vazio, usa VITE_API_URL.
# VITE_URL_HTML=
